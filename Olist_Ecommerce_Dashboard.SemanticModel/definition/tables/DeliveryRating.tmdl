table DeliveryRating
	lineageTag: 49d5a143-1fad-4b32-961d-11189840949c

	measure Measure
		lineageTag: e711d8fb-64bc-4b57-b77e-2d9bc809d160

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Late Delivery Rate' =
			
			DIVIDE(
			    CALCULATE(
			        SUM(DeliveryRating[eligible_delivered_orders]),
			        DeliveryRating[is_late] = 1
			    ),
			    SUM(DeliveryRating[eligible_delivered_orders]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a649b0d3-ffbf-4339-b28a-7a347134d295

	column is_late
		dataType: int64
		formatString: 0
		lineageTag: 08662189-5004-4166-b0ec-b0cffc7198ad
		summarizeBy: sum
		sourceColumn: is_late

		annotation SummarizationSetBy = Automatic

	column delivery_group
		dataType: string
		lineageTag: 5e69b7bf-8175-4922-8dfd-83a8c531abef
		summarizeBy: none
		sourceColumn: delivery_group

		annotation SummarizationSetBy = Automatic

	column eligible_delivered_orders
		dataType: int64
		formatString: 0
		lineageTag: c3446cdb-bad3-4d1d-a13b-c4d4b346d729
		summarizeBy: sum
		sourceColumn: eligible_delivered_orders

		annotation SummarizationSetBy = Automatic

	column orders_with_any_review
