		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column avg_score_all_reviews
		dataType: double
		lineageTag: 868c23d6-03dc-4588-831b-1131daadcffa
		summarizeBy: sum
		sourceColumn: avg_score_all_reviews

