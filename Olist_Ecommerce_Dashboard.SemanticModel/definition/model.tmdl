model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["olist_ecommerce vw_olist_monthly_sales","olist_ecommerce vw_olist_payment_methods","olist_ecommerce vw_olist_category_sales","olist_ecommerce vw_olist_credit_card_installments","DeliveryRating"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'olist_ecommerce vw_olist_monthly_sales'
ref table 'olist_ecommerce vw_olist_payment_methods'
ref table 'olist_ecommerce vw_olist_category_sales'
ref table 'olist_ecommerce vw_olist_credit_card_installments'
ref table DeliveryRating

ref cultureInfo en-US

